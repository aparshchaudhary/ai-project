# Aura AI Voice Command Assistant — Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000

# Voice & Speech
WAKE_WORD=hey assistant
WAKE_WORD_ENABLED=true
DEFAULT_LANGUAGE=en

# Text-to-Speech Settings
TTS_ENGINE=pyttsx3
TTS_RATE=180
TTS_VOLUME=0.9

# Safety & Confirmation Layer
REQUIRE_CONFIRMATION_HIGH_RISK=true
REQUIRE_CONFIRMATION_MED_RISK=true
CLIPBOARD_PERMISSION_ENABLED=true
DEMO_MODE=false

# Optional Cloud AI (Leave empty to use built-in offline NLP engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
